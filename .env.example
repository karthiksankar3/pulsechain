# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=pulsechain
POSTGRES_PASSWORD=pulsechain
POSTGRES_DB=pulsechain
DATABASE_URL=postgresql://pulsechain:pulsechain@localhost:5432/pulsechain

# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── External APIs ────────────────────────────────────────────────────────────
NEWS_API_KEY=your-newsapi-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=PulseChain/1.0

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
